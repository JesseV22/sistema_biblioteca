{% extends "templates/pageModel.njk" %}

{% block content %}
<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header {% if disabled %}bg-info{% else %}bg-warning{% endif %} text-white">
                    <h4 class="mb-0">
                        {% if disabled %}
                        <i class="bi bi-eye"></i> {{ title }}
                        {% else %}
                        <i class="bi bi-pencil"></i> {{ title }}
                        {% endif %}
                    </h4>
                </div>
                <div class="card-body">
                    <form id="formLivro">
                        <input type="hidden" id="livroid" name="livroid" value="{{ data.livroid }}">
                        
                        <div class="mb-3">
                            <label for="titulo" class="form-label">Título *</label>
                            <input type="text" class="form-control" id="titulo" name="titulo" 
                                   value="{{ data.titulo }}" {% if disabled %}disabled{% endif %} required>
                        </div>

                        <div class="mb-3">
                            <label for="categoria" class="form-label">Categoria *</label>
                            <input type="text" class="form-control" id="categoria" name="categoria" 
                                   value="{{ data.categoria }}" {% if disabled %}disabled{% endif %} required>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="preco" class="form-label">Preço *</label>
                                    <input type="number" step="0.01" class="form-control" id="preco" name="preco" 
                                           value="{{ data.preco }}" {% if disabled %}disabled{% endif %} required>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="quantidade" class="form-label">Quantidade *</label>
                                    <input type="number" class="form-control" id="quantidade" name="quantidade" 
                                           value="{{ data.quantidade }}" {% if disabled %}disabled{% endif %} required>
                                </div>
                            </div>
                        </div>

                        <div id="alertMsg" class="alert d-none" role="alert"></div>

                        <div class="d-flex justify-content-between">
                            <a href="/livros" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Voltar
                            </a>
                            {% if not disabled %}
                            <button type="submit" class="btn btn-warning">
                                <i class="bi bi-save"></i> Atualizar
                            </button>
                            {% endif %}
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

{% if not disabled %}
<script>
document.getElementById('formLivro').addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const formData = {
        livroid: parseInt(document.getElementById('livroid').value),
        titulo: document.getElementById('titulo').value,
        categoria: document.getElementById('categoria').value,
        preco: parseFloat(document.getElementById('preco').value),
        quantidade: parseInt(document.getElementById('quantidade').value),
        removido: false
    };
    
    const alertMsg = document.getElementById('alertMsg');
    
    try {
        const response = await fetch('/livros/update', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(formData)
        });
        
        const data = await response.json();
        
        if (data.status === 'ok') {
            alertMsg.className = 'alert alert-success';
            alertMsg.textContent = 'Livro atualizado com sucesso!';
            alertMsg.classList.remove('d-none');
            
            setTimeout(() => {
                window.location.href = '/livros';
            }, 1500);
        } else {
            alertMsg.className = 'alert alert-danger';
            alertMsg.textContent = 'Erro: ' + data.msg;
            alertMsg.classList.remove('d-none');
        }
    } catch (error) {
        alertMsg.className = 'alert alert-danger';
        alertMsg.textContent = 'Erro ao atualizar livro';
        alertMsg.classList.remove('d-none');
    }
});
</script>
{% endif %}
{% endblock %}
