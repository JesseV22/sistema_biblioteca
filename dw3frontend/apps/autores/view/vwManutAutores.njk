{% extends "templates/pageModel.njk" %}

{% block content %}
<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-person"></i> {{ title }}
                    </h4>
                </div>
                <div class="card-body">
                    {% if erro %}
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle"></i> {{ erro }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                    {% endif %}

                    <div class="mb-3">
                        <a href="/autores/insert" class="btn btn-success">
                            <i class="bi bi-plus-circle"></i> Novo Autor
                        </a>
                    </div>

                    {% if data and data.length > 0 %}
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead class="table-dark">
                                <tr>
                                    <th>ID</th>
                                    <th>Nome</th>
                                    <th>Nacionalidade</th>
                                    <th class="text-center">Ações</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for autor in data %}
                                <tr>
                                    <td>{{ autor.autorid }}</td>
                                    <td>{{ autor.nome }}</td>
                                    <td>{{ autor.nacionalidade }}</td>
                                    <td class="text-center">
                                        <a href="/autores/view/{{ autor.autorid }}" class="btn btn-sm btn-info" title="Visualizar">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a href="/autores/update/{{ autor.autorid }}" class="btn btn-sm btn-warning" title="Editar">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <button onclick="deleteAutor({{ autor.autorid }})" class="btn btn-sm btn-danger" title="Excluir">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    {% else %}
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle"></i> Nenhum autor cadastrado.
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>

<script>
async function deleteAutor(id) {
    if (!confirm('Deseja realmente excluir este autor?')) {
        return;
    }

    try {
        const response = await fetch('/autores/delete', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ autorid: id })
        });

        const data = await response.json();

        if (data.status === 'ok') {
            alert('Autor excluído com sucesso!');
            window.location.reload();
        } else {
            alert('Erro ao excluir autor: ' + data.msg);
        }
    } catch (error) {
        alert('Erro ao excluir autor');
    }
}
</script>
{% endblock %}
