{% extends "templates/pageModel.njk" %}

{% block content %}
<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-plus-circle"></i> {{ title }}
                    </h4>
                </div>
                <div class="card-body">
                    <form id="formAutor">
                        <div class="mb-3">
                            <label for="nome" class="form-label">Nome *</label>
                            <input type="text" class="form-control" id="nome" name="nome" required>
                        </div>

                        <div class="mb-3">
                            <label for="nacionalidade" class="form-label">Nacionalidade *</label>
                            <input type="text" class="form-control" id="nacionalidade" name="nacionalidade" required>
                        </div>

                        <div id="alertMsg" class="alert d-none" role="alert"></div>

                        <div class="d-flex justify-content-between">
                            <a href="/autores" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Voltar
                            </a>
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-save"></i> Salvar
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.getElementById('formAutor').addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const formData = {
        nome: document.getElementById('nome').value,
        nacionalidade: document.getElementById('nacionalidade').value,
        removido: false
    };
    
    const alertMsg = document.getElementById('alertMsg');
    
    try {
        const response = await fetch('/autores/insert', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(formData)
        });
        
        const data = await response.json();
        
        if (data.status === 'ok') {
            alertMsg.className = 'alert alert-success';
            alertMsg.textContent = 'Autor cadastrado com sucesso!';
            alertMsg.classList.remove('d-none');
            
            setTimeout(() => {
                window.location.href = '/autores';
            }, 1500);
        } else {
            alertMsg.className = 'alert alert-danger';
            alertMsg.textContent = 'Erro: ' + data.msg;
            alertMsg.classList.remove('d-none');
        }
    } catch (error) {
        alertMsg.className = 'alert alert-danger';
        alertMsg.textContent = 'Erro ao cadastrar autor';
        alertMsg.classList.remove('d-none');
    }
});
</script>
{% endblock %}
