const axios = require("axios");

// Exibir página de login
const Login = (req, res) => {
  res.render("login/view/vwLogin.njk", {
    title: "Login - Sistema de Biblioteca",
    erro: null,
  });
};

/// Processar login
const LoginProcess = async (req, res) => {
  const { username, password } = req.body;

  try {
    const response = await axios.post(
      process.env.SERVIDOR_DW3Back + "/Login",
      {
        UserName: username,   
        Password: password    
      }
    );

    const token = response.data.token;

    if (!token || !response.data.auth) {
      return res.json({
        status: "error",
        message: "Usuário ou senha incorretos"
      });
    }

    req.session.token = token;
    req.session.userName = username;

    return res.json({
      status: "ok",
      redirect: "/home"
    });

  } catch (error) {
    console.log("[ctlLogin|LoginProcess] ERRO:", error.message);
    
    let errorMessage = "Usuário ou senha incorretos";
    if (error.response && error.response.data && error.response.data.message) {
      errorMessage = error.response.data.message;
    }

    return res.json({
      status: "error",
      message: errorMessage
    });
  }
};


// Middleware de autenticação
const AutenticaJWT = (req, res, next) => {
  const token = req.session.token;

  if (!token) {
    return res.redirect("/?erro=nao_autenticado");
  }

  next();
};

// Logout
const Logout = (req, res) => {
  req.session.destroy();
  res.redirect("/");
};

module.exports = {
  Login,
  LoginProcess,
  Logout,
  AutenticaJWT,
};
