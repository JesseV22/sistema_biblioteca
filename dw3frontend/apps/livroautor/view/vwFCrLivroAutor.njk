{% extends "templates/pageModel.njk" %}

{% block content %}
<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-plus-circle"></i> {{ title }}
                    </h4>
                </div>
                <div class="card-body">
                    <form id="formLivroAutor">
                        <div class="mb-3">
                            <label for="livroid" class="form-label">Livro *</label>
                            <select class="form-select" id="livroid" name="livroid" required>
                                <option value="">Selecione um livro</option>
                                {% for livro in livros %}
                                <option value="{{ livro.livroid }}">{{ livro.titulo }}</option>
                                {% endfor %}
                            </select>
                        </div>

                        <div class="mb-3">
                            <label for="autorid" class="form-label">Autor *</label>
                            <select class="form-select" id="autorid" name="autorid" required>
                                <option value="">Selecione um autor</option>
                                {% for autor in autores %}
                                <option value="{{ autor.autorid }}">{{ autor.nome }}</option>
                                {% endfor %}
                            </select>
                        </div>

                        <div id="alertMsg" class="alert d-none" role="alert"></div>

                        <div class="d-flex justify-content-between">
                            <a href="/livroautor" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Voltar
                            </a>
                            <button type="submit" class="btn btn-info">
                                <i class="bi bi-save"></i> Salvar
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.getElementById('formLivroAutor').addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const formData = {
        livroid: parseInt(document.getElementById('livroid').value),
        autorid: parseInt(document.getElementById('autorid').value),
        removido: false
    };
    
    const alertMsg = document.getElementById('alertMsg');
    
    try {
        const response = await fetch('/livroautor/insert', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(formData)
        });
        
        const data = await response.json();
        
        if (data.status === 'ok') {
            alertMsg.className = 'alert alert-success';
            alertMsg.textContent = 'Relação cadastrada com sucesso!';
            alertMsg.classList.remove('d-none');
            
            setTimeout(() => {
                window.location.href = '/livroautor';
            }, 1500);
        } else {
            alertMsg.className = 'alert alert-danger';
            alertMsg.textContent = 'Erro: ' + data.msg;
            alertMsg.classList.remove('d-none');
        }
    } catch (error) {
        alertMsg.className = 'alert alert-danger';
        alertMsg.textContent = 'Erro ao cadastrar relação';
        alertMsg.classList.remove('d-none');
    }
});
</script>
{% endblock %}
