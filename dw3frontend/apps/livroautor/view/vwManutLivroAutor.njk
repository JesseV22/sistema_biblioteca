{% extends "templates/pageModel.njk" %}

{% block content %}
<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-link-45deg"></i> {{ title }}
                    </h4>
                </div>
                <div class="card-body">
                    {% if erro %}
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle"></i> {{ erro }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                    {% endif %}

                    <div class="mb-3">
                        <a href="/livroautor/insert" class="btn btn-info">
                            <i class="bi bi-plus-circle"></i> Nova Relação
                        </a>
                    </div>

                    {% if data and data.length > 0 %}
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead class="table-dark">
                                <tr>
                                    <th>ID</th>
                                    <th>Livro ID</th>
                                    <th>Autor ID</th>
                                    <th class="text-center">Ações</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for item in data %}
                                <tr>
                                    <td>{{ item.livroautorid }}</td>
                                    <td>{{ item.livroid }}</td>
                                    <td>{{ item.autorid }}</td>
                                    <td class="text-center">
                                        <button onclick="deleteLivroAutor({{ item.livroautorid }})" class="btn btn-sm btn-danger" title="Excluir">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    {% else %}
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle"></i> Nenhuma relação cadastrada.
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>

<script>
async function deleteLivroAutor(id) {
    if (!confirm('Deseja realmente excluir esta relação?')) {
        return;
    }

    try {
        const response = await fetch('/livroautor/delete', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ livroautorid: id })
        });

        const data = await response.json();

        if (data.status === 'ok') {
            alert('Relação excluída com sucesso!');
            window.location.reload();
        } else {
            alert('Erro ao excluir relação: ' + data.msg);
        }
    } catch (error) {
        alert('Erro ao excluir relação');
    }
}
</script>
{% endblock %}
